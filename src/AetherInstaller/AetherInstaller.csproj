<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AetherInstaller</AssemblyName>
    <RootNamespace>AetherInstaller</RootNamespace>
    <Product>Aether Browser Setup</Product>
    <Company>Aether</Company>
    <Description>Aether Browser Professional Setup Wizard</Description>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <ApplicationIcon>..\AetherBrowser\Assets\aether.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\AetherBrowser\Assets\aether-256.png" Link="Assets\aether-256.png" />
    <Resource Include="..\AetherBrowser\Assets\aether.ico" Link="Assets\aether.ico" />
  </ItemGroup>

</Project>
