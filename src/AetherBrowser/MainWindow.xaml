<Window x:Class="AetherBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AetherBrowser.Controls"
        Title="Aether Browser"
        Width="1280" Height="820"
        MinWidth="760" MinHeight="460"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/aether.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome"
                      CaptionHeight="42"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootFrame"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Unified Single-Line Bar (Nav + Compact Address Bar + Uniform Pill Tabs + Actions + Window Controls) -->
                <RowDefinition Height="Auto"/> <!-- 1: Optional Bookmarks Bar -->
                <RowDefinition Height="Auto"/> <!-- 2: Optional Update Banner -->
                <RowDefinition Height="Auto"/> <!-- 3: Optional Find Bar -->
                <RowDefinition Height="*"/>    <!-- 4: Optional Vertical Sidebar + CEF Chromium Content -->
                <RowDefinition Height="Auto"/> <!-- 5: Optional Status Bar -->
            </Grid.RowDefinitions>

            <!-- ROW 0: Unified Single-Line Header Bar -->
            <Border x:Name="TopBarBorder"
                    Grid.Row="0"
                    Height="42"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 0: Brand + Nav buttons -->
                        <ColumnDefinition Width="Auto"/> <!-- 1: Compact Address Bar -->
                        <ColumnDefinition Width="*"/>    <!-- 2: Uniform Tabs + New Tab + Drag space -->
                        <ColumnDefinition Width="Auto"/> <!-- 3: Right Toolbar Actions + Window Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Private Badge + Navigation Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border x:Name="PrivateBadge" Visibility="Collapsed"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="99" Padding="7,2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.EyeOff" Size="11" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="Private" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="SidebarToggleBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="ToggleVerticalTabs_Click" ToolTip="Toggle Vertical Tabs">
                            <controls:LucideIcon IconKey="Icon.PanelLeft" Size="14"/>
                        </Button>
                        <Button x:Name="BackBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="BackButton_Click" ToolTip="Back (Alt+Left)">
                            <controls:LucideIcon IconKey="Icon.ArrowLeft" Size="14"/>
                        </Button>
                        <Button x:Name="ForwardBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="ForwardButton_Click" ToolTip="Forward (Alt+Right)">
                            <controls:LucideIcon IconKey="Icon.ArrowRight" Size="14"/>
                        </Button>
                        <Button x:Name="ReloadBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="ReloadButton_Click" ToolTip="Reload (Ctrl+R)">
                            <controls:LucideIcon x:Name="ReloadIcon" IconKey="Icon.RotateCw" Size="13"/>
                        </Button>
                        <Button x:Name="HomeBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="HomeButton_Click" ToolTip="Home" Visibility="Collapsed">
                            <controls:LucideIcon IconKey="Icon.House" Size="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Col 1: Compact Pill Address Bar -->
                    <Border x:Name="AddressBarBorder"
                            Grid.Column="1"
                            Width="{Binding CompactAddressBarWidth}"
                            Height="{Binding BarControlHeight}"
                            VerticalAlignment="Center"
                            Margin="2,0,8,0"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding PillCornerRadius}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Omnibox Indicators: Security Lock + Privacy Shield -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                                <controls:LucideIcon x:Name="SecurityIcon" IconKey="Icon.Search" Size="12" IconBrush="{DynamicResource MutedBrush}" Margin="1,0,4,0"/>
                                <Button x:Name="PrivacyShieldBtn" Style="{StaticResource PillButtonStyle}" Height="22" Padding="5,1" Click="PrivacyShield_Click" ToolTip="Aether Privacy Shield">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LucideIcon x:Name="ShieldIcon" IconKey="Icon.ShieldCheck" Size="12" IconBrush="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="ShieldCountText" Text="0" FontSize="10.5" Margin="3,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Address Input -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AddressPlaceholder"
                                           Text="Search DuckDuckGo or URL..."
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="3,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="AddressBox"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         BorderThickness="0"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Padding="2,0"
                                         GotFocus="AddressBox_GotFocus"
                                         LostFocus="AddressBox_LostFocus"
                                         LostKeyboardFocus="AddressBox_LostFocus"
                                         PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                                         PreviewKeyDown="AddressBox_PreviewKeyDown"
                                         TextChanged="AddressBox_TextChanged"/>
                            </Grid>

                            <!-- Right Omnibox Actions: Zoom + Bookmark -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                                <Button x:Name="ZoomBadgeBtn" Style="{StaticResource PillButtonStyle}" Height="20" Padding="5,1" Visibility="Collapsed" Click="ResetZoom_Click" ToolTip="Reset Zoom (Ctrl+0)">
                                    <TextBlock x:Name="ZoomBadgeText" Text="100%" FontSize="10.5"/>
                                </Button>
                                <Button x:Name="BookmarkBtn" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="ToggleBookmark_Click" ToolTip="Bookmark this page (Ctrl+D)">
                                    <controls:LucideIcon x:Name="BookmarkIcon" IconKey="Icon.Star" Size="13"/>
                                </Button>
                            </StackPanel>

                            <!-- Sleek Bottom Loading Progress Bar inside Address Bar -->
                            <Grid x:Name="AddressProgressTrack"
                                  Grid.ColumnSpan="3"
                                  Height="2"
                                  Margin="12,0,12,0"
                                  VerticalAlignment="Bottom"
                                  ClipToBounds="True"
                                  IsHitTestVisible="False">
                                <Border x:Name="AddressProgressFill"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        Height="2"
                                        CornerRadius="1"
                                        Opacity="0"
                                        Background="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Col 2: Horizontal Uniform Pill Tabs + New Tab Button (dynamically compresses when full!) -->
                    <Grid x:Name="HorizontalTabsHost" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"
                          SizeChanged="HorizontalTabsHost_SizeChanged">
                        <!-- Subtle glow highlight when docking a tab from another window -->
                        <Border x:Name="HorizontalDockHighlight"
                                CornerRadius="{Binding PillCornerRadius}"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="HorizontalTabs_PreviewMouseWheel"
                                          WindowChrome.IsHitTestVisibleInChrome="True">
                                <ItemsControl x:Name="HorizontalTabsList">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TabBorder"
                                                    Height="{Binding DataContext.BarControlHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Width="{Binding DataContext.EffectiveTabWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="1,2,4,2"
                                                    Padding="9,0,6,0"
                                                    CornerRadius="{Binding DataContext.PillCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="TabItem_MouseLeftButtonDown"
                                                    MouseMove="TabItem_MouseMove"
                                                    MouseDown="TabItem_MouseMiddleDown"
                                                    ToolTip="{Binding DisplayTitle}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Tag="{Binding}">
                                                        <MenuItem Header="Duplicate Tab" Click="TabMenu_Duplicate_Click"/>
                                                        <MenuItem Header="Pin / Unpin Tab" Click="TabMenu_Pin_Click"/>
                                                        <MenuItem Header="Mute / Unmute Site" Click="TabMenu_Mute_Click"/>
                                                        <MenuItem Header="Sleep Tab (Low RAM)" Click="TabMenu_Sleep_Click"/>
                                                        <MenuItem Header="Hibernate Tab (0 MB RAM)" Click="TabMenu_Discard_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="Close Tab" Click="TabMenu_Close_Click"/>
                                                        <MenuItem Header="Close Other Tabs" Click="TabMenu_CloseOthers_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Favicon / Sleeping Moon / Globe -->
                                                    <Grid x:Name="TabIconHost" Grid.Column="0" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Image Source="{Binding Favicon}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSleepingOrDiscarded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <controls:LucideIcon IconKey="Icon.Globe" Size="12" IconBrush="{DynamicResource MutedBrush}">
                                                            <controls:LucideIcon.Style>
                                                                <Style TargetType="controls:LucideIcon">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSleepingOrDiscarded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:LucideIcon.Style>
                                                        </controls:LucideIcon>
                                                        <controls:LucideIcon IconKey="Icon.Moon" Size="12" IconBrush="{DynamicResource AccentBrush}">
                                                            <controls:LucideIcon.Style>
                                                                <Style TargetType="controls:LucideIcon">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSleepingOrDiscarded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:LucideIcon.Style>
                                                        </controls:LucideIcon>
                                                    </Grid>

                                                    <!-- Title -->
                                                    <TextBlock x:Name="TabTitleText"
                                                               Grid.Column="1"
                                                               Text="{Binding DisplayTitle}"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Opacity" Value="0.72"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSleepingOrDiscarded}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.48"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.IsIconOnlyTabStrip, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Close Tab Button -->
                                                    <Button x:Name="CloseTabBtn"
                                                            Grid.Column="2"
                                                            Width="18" Height="18"
                                                            Margin="4,0,0,0"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Click="CloseTabButton_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="Close tab (Ctrl+W)">
                                                        <controls:LucideIcon IconKey="Icon.X" Size="10.5"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.IsCompactTabStrip, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CloseTabBtn" Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.IsIconOnlyTabStrip, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter TargetName="CloseTabBtn" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="TabIconHost" Property="Margin" Value="0"/>
                                                    <Setter TargetName="TabIconHost" Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter TargetName="TabBorder" Property="Padding" Value="0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter TargetName="CloseTabBtn" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="TabIconHost" Property="Margin" Value="0"/>
                                                    <Setter TargetName="TabIconHost" Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter TargetName="TabBorder" Property="Width" Value="34"/>
                                                    <Setter TargetName="TabBorder" Property="Padding" Value="0"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="28" Height="28"
                                    Margin="1,0,0,0"
                                    VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="NewTabButton_Click"
                                    ToolTip="New Blank Tab (Ctrl+T)">
                                <controls:LucideIcon IconKey="Icon.Plus" Size="14"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Col 3: Right Toolbar Actions + Subtle Divider + Window Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MemoryBadgeBtn" Style="{StaticResource PillButtonStyle}" Margin="0,0,2,0" Click="MemoryBadge_Click" ToolTip="Live Browser Memory Usage — Click for Memory Saver settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:LucideIcon IconKey="Icon.Cpu" Size="12" IconBrush="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                                <TextBlock x:Name="MemoryBadgeText" Text="-- MB" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExtensionsBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="ExtensionsButton_Click" ToolTip="Extensions">
                            <controls:LucideIcon IconKey="Icon.Puzzle" Size="14"/>
                        </Button>
                        <Button x:Name="DownloadsBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="DownloadsButton_Click" ToolTip="Downloads (Ctrl+J)">
                            <Grid Width="18" Height="18">
                                <controls:LucideIcon IconKey="Icon.Download" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="DownloadActiveDot"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="MenuBtn" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" Click="MenuButton_Click" ToolTip="Menu &amp; Settings">
                            <controls:LucideIcon IconKey="Icon.EllipsisVertical" Size="14"/>
                        </Button>

                        <!-- Subtle Separator before Window Caption Buttons -->
                        <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="6,0,4,0"/>

                        <Button Style="{StaticResource CaptionButtonStyle}" Height="40" Width="38" Click="MinimizeButton_Click" ToolTip="Minimize">
                            <controls:LucideIcon IconKey="Icon.Minus" Size="12"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Height="40" Width="38" Click="MaximizeButton_Click" ToolTip="Maximize / Restore">
                            <controls:LucideIcon x:Name="MaximizeIcon" IconKey="Icon.Square" Size="11"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButtonStyle}" Height="40" Width="40" Click="CloseWindowButton_Click" ToolTip="Close">
                            <controls:LucideIcon IconKey="Icon.X" Size="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: Optional Minimalist Bookmarks Bar -->
            <Border x:Name="BookmarksBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,4">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BookmarksBarList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PillButtonStyle}" Margin="0,0,4,0" Click="BookmarkBarItem_Click" Tag="{Binding Url}" ToolTip="{Binding Url}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LucideIcon IconKey="Icon.Bookmark" Size="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Title}" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ROW 2: Auto-Update Notification Banner -->
            <Border x:Name="UpdateBanner"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:LucideIcon Grid.Column="0" IconKey="Icon.Sparkles" Size="15" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="UpdateBannerText" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButtonStyle}" Background="{DynamicResource AccentBrush}" Foreground="#111113" Padding="12,3" Margin="0,0,6,0" Click="InstallUpdateBanner_Click">
                            <TextBlock Text="Update &amp; Restart" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="DismissUpdateBanner_Click" ToolTip="Dismiss">
                            <controls:LucideIcon IconKey="Icon.X" Size="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 3: Find-in-Page Bar (Ctrl+F) -->
            <Border x:Name="FindBar"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:LucideIcon IconKey="Icon.Search" Size="14" IconBrush="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
                    <TextBox x:Name="FindBox"
                             Width="220" Height="26"
                             Background="{DynamicResource Surface2Brush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="8,3"
                             VerticalContentAlignment="Center"
                             KeyDown="FindBox_KeyDown"/>
                    <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Margin="4,0,0,0" Click="FindNext_Click" ToolTip="Find Next">
                        <controls:LucideIcon IconKey="Icon.ChevronDown" Size="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Click="FindClose_Click" ToolTip="Close (Esc)">
                        <controls:LucideIcon IconKey="Icon.X" Size="13"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ROW 4: Optional Vertical Tab Sidebar + WebView Content Host -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Vertical Tab Sidebar -->
                <Border x:Name="VerticalTabsSidebar"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Top"
                                Style="{StaticResource MenuRowButtonStyle}"
                                Background="{DynamicResource Surface2Brush}"
                                Margin="0,0,0,8"
                                Click="NewTabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.Plus" Size="14" Margin="0,0,8,0"/>
                                <TextBlock Text="New Blank Tab" FontSize="12.5" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource MenuRowButtonStyle}"
                                Margin="0,8,0,0"
                                Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.Settings" Size="14" IconBrush="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Button>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="VerticalTabsList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="VTabBorder"
                                                Height="34"
                                                Margin="0,0,0,4"
                                                Padding="9,0,6,0"
                                                CornerRadius="8"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="TabItem_MouseLeftButtonDown"
                                                MouseMove="TabItem_MouseMove"
                                                MouseDown="TabItem_MouseMiddleDown"
                                                ToolTip="{Binding MemoryStateLabel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0">
                                                    <Image Source="{Binding Favicon}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <controls:LucideIcon IconKey="Icon.Globe" Size="13" IconBrush="{DynamicResource MutedBrush}">
                                                        <controls:LucideIcon.Style>
                                                            <Style TargetType="controls:LucideIcon">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:LucideIcon.Style>
                                                    </controls:LucideIcon>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Width="20" Height="20" Style="{StaticResource IconButtonStyle}" Click="CloseTabButton_Click" Tag="{Binding}">
                                                    <controls:LucideIcon IconKey="Icon.X" Size="11"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="VTabBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                <Setter TargetName="VTabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <Trigger SourceName="VTabBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="VTabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Active CEF Chromium Container -->
                <Grid x:Name="WebViewHostGrid" Grid.Column="1" Background="{DynamicResource BgBrush}"/>
            </Grid>

            <!-- ROW 5: Optional Minimalist Status Bar -->
            <Border x:Name="StatusBarBorder"
                    Grid.Row="5"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,3">
                <Grid>
                    <TextBlock x:Name="StatusUrlText" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusRightText" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="Aether Privacy Shield Active"/>
                </Grid>
            </Border>

            <!-- POPUP 1: Address Bar Autocomplete (with real site logos + instant click!) -->
            <Popup x:Name="AutocompletePopup"
                   PlacementTarget="{Binding ElementName=AddressBarBorder}"
                   Placement="Custom"
                   StaysOpen="True"
                   AllowsTransparency="True">
                <Border Width="460"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="6">
                    <ItemsControl x:Name="AutocompleteList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBd"
                                        CornerRadius="7"
                                        Padding="9,8"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="AutocompleteItem_MouseDown"
                                        Tag="{Binding Url}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Real Site Logo (Favicon) or Crisp Lucide Fallback -->
                                        <Border Grid.Column="0"
                                                Width="22" Height="22"
                                                CornerRadius="6"
                                                Background="{DynamicResource Surface2Brush}"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding Favicon}" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <controls:LucideIcon IconKey="{Binding IconKey}" Size="12" IconBrush="{DynamicResource MutedBrush}">
                                                    <controls:LucideIcon.Style>
                                                        <Style TargetType="controls:LucideIcon">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:LucideIcon.Style>
                                                </controls:LucideIcon>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                CornerRadius="99"
                                                Background="{DynamicResource Surface2Brush}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="ItemBd" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!-- POPUP 2: Built-In AdBlocker & Privacy Shield Popover -->
            <Popup x:Name="PrivacyPopup"
                   PlacementTarget="{Binding ElementName=PrivacyShieldBtn}"
                   Placement="Custom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="320"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:LucideIcon IconKey="Icon.ShieldCheck" Size="18" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="AdBlocker &amp; Shield" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="PrivacyPopupCount" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="PrivacyPopupHost" Text="Current site" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock x:Name="PrivacyPopupRulesInfo" Text="Built-in AdBlocker active" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AdBlockerMasterBtn" Grid.Column="0" Style="{StaticResource MenuRowButtonStyle}" Background="{DynamicResource AccentSoftBrush}" Click="AdBlockerMasterToggle_Click">
                                <TextBlock x:Name="AdBlockerMasterText" Text="AdBlocker: ON" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </Button>
                            <Button x:Name="PrivacyToggleSiteBtn" Grid.Column="2" Style="{StaticResource MenuRowButtonStyle}" Background="{DynamicResource Surface2Brush}" Click="PrivacyToggleSite_Click">
                                <TextBlock x:Name="PrivacyToggleSiteText" Text="Pause on site" HorizontalAlignment="Center" FontWeight="Medium" FontSize="12"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Blocked ads &amp; trackers on this tab:" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PrivacyBlockedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" Opacity="0.82" Margin="2,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,10"/>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="UpdateAdBlockListsPopup_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.RefreshCw" Size="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="UpdateAdBlockPopupText" Text="Update Community Filter Lists"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenPrivacySettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.Settings" Size="14" Margin="0,0,8,0"/>
                                <TextBlock Text="AdBlocker &amp; Privacy Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- POPUP 3: Extensions Popover -->
            <Popup x:Name="ExtensionsPopup"
                   PlacementTarget="{Binding ElementName=ExtensionsBtn}"
                   Placement="Custom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="300"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                            <controls:LucideIcon IconKey="Icon.Puzzle" Size="16" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Extensions" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <TextBlock x:Name="ExtensionsEmptyText" Text="No extensions installed yet." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="4,4,4,10" Visibility="Collapsed"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ExtensionsPopupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="ExtensionPopupItem_Click" Tag="{Binding Id}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                                <controls:LucideIcon Grid.Column="1" IconKey="Icon.ExternalLink" Size="13" IconBrush="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,8"/>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenExtensionsPage_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.Package" Size="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Manage &amp; Install Extensions"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- POPUP 3B: Downloads Dropdown (Chrome / Arc style!) -->
            <Popup x:Name="DownloadsPopup"
                   PlacementTarget="{Binding ElementName=DownloadsBtn}"
                   Placement="Custom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="340"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel>
                        <Grid Margin="2,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:LucideIcon IconKey="Icon.Download" Size="16" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Recent Downloads" FontWeight="SemiBold" FontSize="13.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="DownloadsPopup_OpenFolder_Click" ToolTip="Open Downloads Folder">
                                    <controls:LucideIcon IconKey="Icon.FolderOpen" Size="13"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Click="DownloadsPopup_Clear_Click" ToolTip="Clear Download History">
                                    <controls:LucideIcon IconKey="Icon.Trash2" Size="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DownloadsEmptyText"
                                   Text="No recent downloads yet."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12"
                                   Margin="4,8,4,12"
                                   Visibility="Collapsed"/>

                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DownloadsPopupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="DlRow"
                                                CornerRadius="8"
                                                Padding="9,8"
                                                Margin="0,0,0,3"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="DownloadPopupItem_OpenFile_Click"
                                                Tag="{Binding FilePath}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="28" Height="28"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource Surface2Brush}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <controls:LucideIcon IconKey="Icon.Download" Size="13" IconBrush="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Maximum="100"
                                                                 Height="3"
                                                                 Margin="0,5,0,0"
                                                                 BorderThickness="0"
                                                                 Background="{DynamicResource Surface2Brush}"
                                                                 Foreground="{DynamicResource AccentBrush}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Width="26" Height="26"
                                                        Margin="6,0,0,0"
                                                        Click="DownloadPopupItem_ShowInFolder_Click"
                                                        Tag="{Binding FilePath}"
                                                        ToolTip="Show in Folder">
                                                    <controls:LucideIcon IconKey="Icon.FolderOpen" Size="13"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="DlRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DlRow" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,8"/>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="DownloadsPopup_ViewAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon IconKey="Icon.ExternalLink" Size="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Show All Downloads"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- POPUP 4: Main Minimalist App Menu -->
            <Popup x:Name="MainMenuPopup"
                   PlacementTarget="{Binding ElementName=MenuBtn}"
                   Placement="Custom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="260"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="6">
                    <StackPanel>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_NewTab_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Plus" Size="14" Margin="0,0,10,0"/><TextBlock Text="New Blank Tab"/></StackPanel><TextBlock Text="Ctrl+T" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_NewWindow_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Layers" Size="14" Margin="0,0,10,0"/><TextBlock Text="New Window"/></StackPanel><TextBlock Text="Ctrl+N" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_NewPrivateWindow_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.EyeOff" Size="14" Margin="0,0,10,0"/><TextBlock Text="New Private Window"/></StackPanel><TextBlock Text="Ctrl+Shift+N" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="4,4"/>

                        <!-- Zoom Row -->
                        <Grid Margin="10,4">
                            <TextBlock Text="Zoom" VerticalAlignment="Center" FontSize="12.5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Click="ZoomOut_Click"><controls:LucideIcon IconKey="Icon.ZoomOut" Size="13"/></Button>
                                <TextBlock x:Name="MenuZoomLabel" Text="100%" VerticalAlignment="Center" Margin="8,0" FontSize="12"/>
                                <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Click="ZoomIn_Click"><controls:LucideIcon IconKey="Icon.ZoomIn" Size="13"/></Button>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="4,4"/>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_History_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.History" Size="14" Margin="0,0,10,0"/><TextBlock Text="History"/></StackPanel><TextBlock Text="Ctrl+H" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_Bookmarks_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Bookmark" Size="14" Margin="0,0,10,0"/><TextBlock Text="Bookmarks"/></StackPanel></Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_Downloads_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Download" Size="14" Margin="0,0,10,0"/><TextBlock Text="Downloads"/></StackPanel><TextBlock Text="Ctrl+J" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenExtensionsPage_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Puzzle" Size="14" Margin="0,0,10,0"/><TextBlock Text="Extensions"/></StackPanel></Grid>
                        </Button>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="4,4"/>
                        <Button x:Name="MenuSetDefaultBtn" Style="{StaticResource MenuRowButtonStyle}" Click="Menu_SetDefaultBrowser_Click">
                            <StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Globe" Size="14" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Set as Default Browser"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_SleepInactive_Click">
                            <StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Moon" Size="14" Margin="0,0,10,0"/><TextBlock Text="Sleep Inactive Tabs &amp; Purge RAM"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_CheckUpdates_Click">
                            <StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.RefreshCw" Size="14" Margin="0,0,10,0"/><TextBlock Text="Check for Updates"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="Menu_DevTools_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Terminal" Size="14" Margin="0,0,10,0"/><TextBlock Text="Developer Tools"/></StackPanel><TextBlock Text="F12" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenSettings_Click">
                            <Grid><StackPanel Orientation="Horizontal"><controls:LucideIcon IconKey="Icon.Settings" Size="14" Margin="0,0,10,0"/><TextBlock Text="Settings"/></StackPanel><TextBlock Text="Ctrl+," HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <!-- POPUP 5: Floating Tab Tear-Off Preview Pill -->
            <Popup x:Name="TabTearOffPopup"
                   Placement="Absolute"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   IsHitTestVisible="False">
                <Border x:Name="TabTearOffBorder"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7"
                        RenderTransformOrigin="0.5,0.5"
                        Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TabTearOffScale" ScaleX="0.88" ScaleY="0.88"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:LucideIcon IconKey="Icon.ExternalLink" Size="13" IconBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock x:Name="TabTearOffTitle" Text="Tab" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TabTearOffHint" Text="Release to open in new window" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
